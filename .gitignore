# Vivado generated and synthesis products (not in version control, reproduced by scripts)
*.bit
*.bin
*.xsa
*.ltx
*.runs/
*.cache/
*.hw/
*.ip_user_files/
*.sim/
*.srcs/
*.gen/
*.xpr
*.jou
*.log
*.str
*.dcp
*.rpt
*.pb
checkpoint/
# Vivado checkpoint and report intermediates
*.dcp
*_utilization*.rpt
*_timing*.rpt
*_power*.rpt

# Bitstream and synthesis product directories
out/
build/
synth_out/
impl_out/

# Run logs (logs/ directory is kept, log files are not in version control)
logs/*.log
logs/*.rpt
logs/*.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# macOS / editor temporary files
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# Stage run logs are traceability evidence: version them (overrides *.log
# and logs/*.log / logs/*.txt above)
!logs/stage*/
!logs/stage*/*.log
!logs/stage*/*.txt

# C build products (rebuilt by make)
*.o
sw/common/driver/test_driver

# Stage 7c generated netlists + e2e checkpoints (reproduced by tb/run_postsynth.sh / sw/vision/run_e2e.py)
logs/stage7c/*.v
logs/stage7c/ckpt_*/
